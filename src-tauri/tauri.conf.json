{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Human Composer",
  "version": "0.1.0",
  "identifier": "com.artrix.human-composer",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Human Composer",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "windowEffects": {
          "effects": ["contentBackground"],
          "radius": 12
        }
      },
      {
        "label": "floating",
        "title": "Human Composer",
        "url": "floating.html",
        "width": 300,
        "height": 36,
        "decorations": false,
        "alwaysOnTop": true,
        "acceptFirstMouse": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "visible": true,
        "transparent": true,
        "shadow": true,
        "windowEffects": {
          "effects": ["contentBackground"],
          "radius": 12
        }
      },
      {
        "label": "floating-notice",
        "title": "Human Composer",
        "url": "floating-notice.html",
        "width": 300,
        "height": 28,
        "decorations": false,
        "alwaysOnTop": true,
        "acceptFirstMouse": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "visible": false,
        "transparent": true,
        "shadow": true,
        "windowEffects": {
          "effects": ["contentBackground"],
          "radius": 12
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
